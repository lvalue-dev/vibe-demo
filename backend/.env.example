# ══════════════════════════════════════════════════════════════════════════════
# Node.js 백엔드 환경변수
# ══════════════════════════════════════════════════════════════════════════════

# ── [개발계] Yahoo Finance 모드 (GitHub Pages + Render) ────────────────────────
# 아래 한 줄만 설정하면 KIS 없이도 동작
STOCK_SOURCE=yahoo

# ── [운영계] 한국투자증권 KIS API (Oracle Cloud + Java 백엔드) ─────────────────
# * Java 백엔드(backend/Dockerfile.java)를 사용할 경우에만 해당
# * apiportal.koreainvestment.com 에서 발급
# KIS_APP_KEY=your_app_key_here
# KIS_APP_SECRET=your_app_secret_here
# KIS_MODE=real    # paper(모의투자) | real(실전투자)

# ── 서버 공통 설정 ──────────────────────────────────────────────────────────────
PORT=3001

# 허용할 프론트엔드 URL (쉼표로 여러개)
# 개발: localhost 포함 / 운영: GitHub Pages 도메인만
FRONTEND_URL=http://localhost:5173,https://lvalue-dev.github.io
